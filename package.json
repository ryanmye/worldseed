{
  "name": "worldseed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude '.claude/**'",
    "typecheck": "tsc --noEmit",
    "realism:check": "node --experimental-strip-types --no-warnings src/sim/history/realismStats.ts --check docs/realism-baseline.jsonl",
    "realism:check:noise": "node --experimental-strip-types --no-warnings src/sim/history/realismStats.ts --check docs/realism-baseline.jsonl --noise docs/realism-noise.jsonl",
    "preset:sanity": "node --experimental-strip-types --no-warnings src/sim/history/presetStats.ts --check"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
